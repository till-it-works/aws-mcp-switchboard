{
  "name": "aws-mcp-switchboard",
  "version": "0.4.11",
  "description": "One remote MCP connector for every AWS account and role you reach through IAM Identity Center.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/till-it-works/aws-mcp-switchboard.git"
  },
