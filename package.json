    "@aws-sdk/client-lambda": "^3.1175.0",
    "@aws-sdk/client-ssm": "^3.1175.0",
    "@aws-sdk/client-sso": "^3.1174.0",
    "@aws-sdk/client-sso-oidc": "^3.1174.0",
    "@aws-sdk/client-sts": "^3.1174.0",
    "@smithy/signature-v4": "^5.7.5"
  },
  "devDependencies": {
    "@aws-sdk/credential-providers": "^3.1174.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": "./cdk/lib/index.ts"
